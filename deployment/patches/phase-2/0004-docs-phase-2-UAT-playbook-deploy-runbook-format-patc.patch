++      userId: 'user-A',
++      path: 'rag',
++      state: 'embedded',
++    });
++    emitStatusUpdate({
++      file_id: 'f2',
++      conversationId: 'unrelated',
++      userId: 'user-A',
++      path: 'rag',
++      state: 'embedded',
++    });
++
++    const text = res.writes.join('');
++    expect(text).toContain('"file_id":"f1"');
++    expect(text).not.toContain('"file_id":"f2"');
