@@ -2922,3 +2922,62 @@ html {
 .sharepoint-picker-bg {
   background-color: #f5f5f5;
 }
+
+/* Phase 2 — file-status chip below uploaded / generated files. */
+.file-status-chip {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  padding: 2px 8px;
+  border-radius: 12px;
+  font-size: 0.75rem;
+  line-height: 1.25;
+  background-color: var(--surface-secondary);
+  color: var(--text-secondary);
+  border: 1px solid var(--border-light);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  max-width: 100%;
+}
+
+.file-status-chip.chip-success {
+  color: var(--green-700);
+  border-color: var(--green-300);
+  background-color: var(--green-50);
+}
+
+.dark .file-status-chip.chip-success {
+  color: var(--green-300);
+  border-color: var(--green-700);
+  background-color: rgba(16, 185, 129, 0.08);
+}
+
+.file-status-chip.chip-warn {
+  color: var(--amber-600);
+  border-color: var(--amber-300);
+  background-color: var(--amber-50);
+}
+
+.dark .file-status-chip.chip-warn {
+  color: var(--amber-300);
+  border-color: var(--amber-700);
+  background-color: rgba(245, 158, 11, 0.08);
+}
+
+.file-status-chip.chip-error {
+  color: var(--red-700);
+  border-color: var(--red-300);
+  background-color: var(--red-50);
+}
+
+.dark .file-status-chip.chip-error {
+  color: var(--red-300);
+  border-color: var(--red-700);
+  background-color: rgba(239, 68, 68, 0.08);
+}
+
+.file-status-chip.chip-pending {
+  color: var(--text-tertiary);
+  border-style: dashed;
+}
